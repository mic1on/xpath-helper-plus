{
  "name": "xpath-helper-plus",
  "displayName": "XPath Helper Plus",
  "author": "MicLon",
  "private": true,
  "version": "2.0.1",
  "packageManager": "pnpm@10.28.1",
  "description": "Generate, evaluate, and inspect XPath expressions directly on any page.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm clear && cross-env NODE_ENV=development run-p dev:*",
    "dev:prepare": "esno scripts/prepare.ts",
    "dev:background": "vite build --config vite.config.background.mts --mode development",
    "dev:web": "vite --config vite.config.mts",
    "dev:content": "vite build --config vite.config.content.mts --mode development",
    "build": "cross-env NODE_ENV=production run-s clear build:web build:prepare build:background build:content",
    "build:prepare": "esno scripts/prepare.ts",
    "build:background": "vite build --config vite.config.background.mts",
    "build:web": "vite build --config vite.config.mts",
    "build:content": "vite build --config vite.config.content.mts",
    "clear": "rimraf --glob dist extension/dist extension/manifest.json extension.zip",
    "lint": "eslint --cache .",
    "release:pack": "pnpm build && node scripts/package-release.mjs",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:e2e": "bash scripts/e2e-ego.sh"
  },
  "dependencies": {
    "@vueuse/core": "^12.8.2",
    "vue": "^3.2.25",
    "xpath-to-css": "^1.1.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^4.19.0",
    "@types/chrome": "^0.2.7",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.19.43",
    "@vitejs/plugin-vue": "^5.2.4",
    "chokidar": "^4.0.3",
    "cross-env": "^7.0.3",
    "eslint": "^9.34.0",
    "esno": "^4.8.0",
    "fs-extra": "^11.3.1",
    "jsdom": "^26.1.0",
    "kolorist": "^1.8.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.3",
    "unocss": "^66.8.1",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^6.4.3",
    "vitest": "^3.2.7",
    "vue-tsc": "~2.2.12"
  }
}
